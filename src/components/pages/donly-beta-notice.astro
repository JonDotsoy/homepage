---
import { ExternalLink, Star } from "lucide-react";

export interface Props {
  githubUrl: string;
  /** When the beta notice was published. Accepts anything `Date` can parse, or a timestamp. */
  releaseDate: string | number | Date;
  /** How many days after `releaseDate` the notice stays visible. */
  expirationDays: number;
  /** Reference "current" time, as a timestamp. Defaults to `Date.now()`. */
  now?: number;
}

const {
  githubUrl,
  releaseDate,
  expirationDays,
  now = Date.now(),
} = Astro.props;

function toTimestamp(value: string | number | Date): number {
  return value instanceof Date ? value.getTime() : new Date(value).getTime();
}

const released = toTimestamp(releaseDate);
const elapsedDays = (now - released) / (1000 * 60 * 60 * 24);
const isVisible =
  isFinite(released) && elapsedDays >= 0 && elapsedDays <= expirationDays;
---

{
  isVisible && (
    <div class="flex flex-col gap-4 rounded-lg border border-border bg-card p-6">
      <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground">
        Beta pública
      </span>
      <h2 class="text-lg font-semibold text-foreground">
        Buscando revisores para la v0.1.0
      </h2>
      <p class="text-sm text-muted-foreground">
        Estoy por lanzar la <span class="font-medium text-foreground"
          >versión 0.1.0</span
        >, la primera beta pública de <span class="font-medium text-foreground"
          >donly</span
        >. Si usas DON o te interesa el proyecto, me encantaría que la
        revisaras antes del lanzamiento: sintaxis, CLI, tipos, docs o
        cualquier detalle que encuentres.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={`${githubUrl}/issues/new`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-foreground px-4 py-2 text-sm font-medium text-background transition-colors hover:opacity-90"
        >
          Quiero revisarla
          <ExternalLink className="size-3.5 opacity-80" />
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
        >
          <Star className="size-3.5" />
          Dale una estrella en GitHub
        </a>
      </div>
    </div>
  )
}
