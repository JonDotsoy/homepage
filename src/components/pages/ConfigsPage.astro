    <script>
      const button = document.getElementById(
        "copy-page-button",
      ) as HTMLButtonElement | null;
      const label = button?.querySelector("span");
      const markdownSource = document.getElementById("page-markdown-source");

      button?.addEventListener("click", async () => {
        if (!label || !markdownSource) return;
        try {
          await navigator.clipboard.writeText(markdownSource.textContent ?? "");
          const original = label.textContent;
          label.textContent = button.dataset.copiedLabel ?? original;
          setTimeout(() => {
            label.textContent = original;
          }, 1500);
        } catch (error) {
          console.error("Failed to copy page as markdown", error);
        }
      });

      const pageMenu = document.querySelector("header details");
      document.addEventListener("click", (event) => {
        if (
          pageMenu instanceof HTMLDetailsElement &&
          pageMenu.open &&
          !pageMenu.contains(event.target as Node)
        ) {
          pageMenu.open = false;
        }
      });
      pageMenu?.addEventListener("click", (event) => {
        if (
          pageMenu instanceof HTMLDetailsElement &&
          (event.target as HTMLElement).closest("a")
        ) {
          pageMenu.open = false;
        }
      });
    </script>

