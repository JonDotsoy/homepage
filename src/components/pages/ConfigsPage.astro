---
import DefaultLayout from "@/components/layouts/DefaultLayout.astro";
import Footer from "@/sections/footer.astro";
import { Code } from "astro:components";
import { ArrowLeft, ChevronDown, Copy, ExternalLink } from "lucide-react";
import pageMarkdownEs from "./configs.es.md?raw";
import pageMarkdownEn from "./configs.en.md?raw";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const pageMarkdown = lang === "en" ? pageMarkdownEn : pageMarkdownEs;

const sourcesEs = [
  {
    name: "envSource",
    path: "@jondotsoy/configs/sources/env",
    description:
      "Lee variables de entorno — process.env u otro objeto pasado como env — hacia el árbol de config, un campo por clave (mapeada por mapKey).",
    options: [
      {
        name: "env",
        detail: "los env vars a leer. Por defecto, process.env.",
      },
      {
        name: "prefix",
        detail:
          "solo se incluyen claves que empiezan con prefix; el prefix se remueve antes de que corra mapKey.",
      },
      {
        name: "suffix",
        detail:
          "solo se incluyen claves que terminan con suffix; el suffix se remueve antes de que corra mapKey.",
      },
      {
        name: "mapKey.snakeCase(options?)",
        detail:
          'divide una clave SCREAMING_SNAKE_CASE en un path anidado en minúsculas por separator (por defecto "_"): "FOO_TAR" => ["foo", "tar"]. Un separator distinto (p. ej. "__") evita que un guion bajo dentro de un segmento se divida.',
      },
      {
        name: "mapKey.identity()",
        detail:
          'pasa cada clave sin cambios, como un path de un solo segmento: "FOO_TAR" => ["FOO_TAR"]. Es lo mismo que omitir mapKey.',
      },
      {
        name: "mapKey.camelCase()",
        detail:
          'mapea una clave a un solo segmento camelCase: "FOO_TAR" => ["fooTar"].',
      },
      {
        name: "mapKey.lookup(table, fallback?)",
        detail:
          "mapea claves específicas a paths explícitos vía una tabla Record<string, string[]>; una clave fuera de la tabla cae al fallback (por defecto, la identidad).",
      },
    ],
    note: "También puedes pasar tu propio EnvKeyMapper en vez de una estrategia integrada — es solo una función (key: string) => string[].",
    example: `import { envSource, mapKey } from "@jondotsoy/configs/sources/env";

// SERVER_PORT=3000 SERVER_HOST=localhost → { server: { port: "3000", host: "localhost" } }
const source = envSource({ mapKey: mapKey.snakeCase() });

// PORT=3000 HOST=localhost → { server: { port: "3000" }, HOST: "localhost" }
const source2 = envSource({ mapKey: mapKey.lookup({ PORT: ["server", "port"] }) });`,
  },
  {
    name: "fetchSource",
    path: "@jondotsoy/configs/sources/fetch",
    description:
      "Descarga un snapshot desde url. El body de la respuesta se convierte a T vía bodyParser (por defecto (res) => res.json()), así que también soporta respuestas que no sean JSON pasando un parser propio.",
    options: [
      {
        name: "method",
        detail: "método HTTP a usar para el request.",
      },
      {
        name: "headers",
        detail: "headers a enviar con el request.",
      },
      {
        name: "body",
        detail:
          "cuerpo del request, se pasa tal cual a fetch (un string JSON, FormData, Blob, etc.).",
      },
      {
        name: "signal",
        detail:
          "aborta el fetch en curso (y detiene su reintento) cuando la señal se dispara. Solo cubre una ronda — con pollingInterval activo, las rondas siguientes igual corren; cierra el Source mismo para detener el polling por completo.",
      },
      {
        name: "mode / cache / redirect",
        detail:
          'se pasan tal cual a fetch. Ver RequestInit["mode"], RequestInit["cache"] y RequestInit["redirect"].',
      },
      {
        name: "credentials",
        detail:
          "arma el header Authorization: { basic: { username, password } } envía Basic <base64>; { bearer: { token } } envía Bearer <token>.",
      },
      {
        name: "bodyParser",
        detail:
          "convierte el Response descargado en T. Por defecto, (res) => res.json().",
      },
      {
        name: "acceptStatus",
        detail:
          "decide si un status code cuenta como aceptado. Por defecto, 2xx: (statusCode) => statusCode >= 200 && statusCode < 300.",
      },
      {
        name: "attempts",
        detail:
          "reintenta la descarga ante un error de red o una respuesta que no sea ok (por defecto 1, sin reintento).",
      },
      {
        name: "pollingInterval",
        detail:
          "apagado por defecto (false): fetchSource descarga url una sola vez y se cierra. Pasa un número de milisegundos para activar el polling — sigue re-descargando en ese intervalo (cada ronda reintentada hasta attempts veces) hasta que el Source se cierre.",
      },
      {
        name: "treePath",
        detail:
          'selecciona un subárbol del body descargado para usar como árbol de config, p. ej. ["containers", "settings"]. Por defecto [] usa el body completo, sin cambios.',
      },
      {
        name: "reduce",
        detail:
          "combina cada descarga exitosa con el valor publicado anteriormente en vez de reemplazarlo por completo. Útil con pollingInterval cuando una ronda posterior es una actualización parcial. Recibe el body recién descargado (y ya filtrado por treePath) como incoming y el último valor publicado como previous (null antes de la primera ronda). Por defecto publica incoming tal cual — un reemplazo completo.",
      },
    ],
    note: "Si la descarga nunca tiene éxito (error de red, o un status rechazado por acceptStatus tras agotar attempts), o bodyParser lanza, fetchSource registra un console.error y deja el store vacío en vez de lanzar. Una ronda fallida después de la primera se registra y se salta, sin cerrar el source ni detener el polling.",
    example: `import { fetchSource } from "@jondotsoy/configs/sources/fetch";
import { Temporal } from "temporal-polyfill";

const source = fetchSource<{ port: number }>({
  url: "https://config-service.internal/app",
  method: "GET",
  headers: { authorization: \`Bearer \${process.env.CONFIG_TOKEN}\` },
  attempts: 3,
  // Apagado por defecto — pasa milisegundos para hacer polling en vez de un solo fetch.
  pollingInterval: Temporal.Duration.from({ seconds: 30 }).total("milliseconds"),
});`,
  },
  {
    name: "sseSource",
    path: "@jondotsoy/configs/sources/sse",
    description:
      "Se conecta a un endpoint SSE. Cada mensaje intenta parsearse como JSON y, si es un objeto plano, se aplica como patch sobre lo ya recibido — los campos se suman y sobrescriben, el árbol nunca se reemplaza por completo.",
    options: [
      {
        name: "method",
        detail: "método HTTP para abrir la conexión.",
      },
      {
        name: "headers",
        detail: "headers a enviar al abrir la conexión SSE.",
      },
      {
        name: "body",
        detail:
          "cuerpo del request, se pasa tal cual a fetch (un string JSON, FormData, Blob, etc.).",
      },
      {
        name: "signal",
        detail:
          "aborta la conexión (y detiene su reintento) cuando la señal se dispara. Independiente del close() propio del Source, que también aborta la conexión.",
      },
      {
        name: "mode / cache / redirect",
        detail:
          'se pasan tal cual a fetch. Ver RequestInit["mode"], RequestInit["cache"] y RequestInit["redirect"].',
      },
      {
        name: "credentials",
        detail:
          "arma el header Authorization: { basic: { username, password } } envía Basic <base64>; { bearer: { token } } envía Bearer <token>.",
      },
      {
        name: "attempts",
        detail:
          "intenta establecer la conexión antes de darse por vencido (por defecto 1, sin reintento).",
      },
      {
        name: "acceptStatus",
        detail:
          "decide si un status code cuenta como aceptado. Por defecto, 2xx: (statusCode) => statusCode >= 200 && statusCode < 300.",
      },
      {
        name: "reduce",
        detail:
          "combina cada mensaje parseado con el árbol acumulado hasta ahora, sobreescribiendo el patch-merge superficial por defecto (campos nuevos se agregan, existentes se sobreescriben, el resto se conserva). Recibe el mensaje parseado como incoming y el árbol publicado previamente como previous (null antes del primer mensaje). Un reduce propio reemplaza ese comportamiento por completo, así que debe encargarse de su propio merge si aún lo quieres.",
      },
    ],
    note: "Un mensaje que no sea JSON válido, o que no parsee a un objeto plano, se registra vía console.error y se salta — nunca resetea lo ya recibido. Abrir el source espera el primer mensaje (así el Store que recibes ya trae datos, no null), y luego mantiene la conexión viva en segundo plano, aplicando más mensajes como patches hasta que el recurso cierre el stream. Además de url/method/headers, acepta las mismas opciones de fetchSource para dar forma al request; attempts solo reintenta la conexión inicial — una vez abierto el stream, una conexión caída cierra el source en vez de reconectar.",
    example: `import { sseSource } from "@jondotsoy/configs/sources/sse";

const source = sseSource<{ port?: number; host?: string }>({
  url: "https://config-service.internal/app/events",
});

// mensaje: {"port":3000}       => Store<{ port: 3000 }>
// mensaje: {"host":"10.0.0.1"} => Store<{ port: 3000, host: "10.0.0.1" }>`,
  },
  {
    name: "fileSource",
    path: "@jondotsoy/configs/sources/file",
    description:
      "Lee un árbol de config desde path — un string o una URL file: —, parseado según su extensión: .json o .env por defecto (por extensión, o por el nombre de archivo .env a secas — un archivo .env siempre parsea a un mapa plano de strings, una entrada por línea KEY=VALUE, saltando líneas en blanco y comentarios #), o cualquier otro formato vía un parser propio.",
    options: [
      {
        name: "watch",
        detail:
          "true por defecto: el archivo se relee y el store se actualiza en vivo en cada cambio; watch: false lo lee una sola vez.",
      },
      {
        name: "treePath",
        detail:
          'selecciona un subárbol del archivo parseado para usar como árbol de config, p. ej. ["containers", "settings"] para usar el objeto interno de { containers: { settings: {...} } } e ignorar el resto. Por defecto [] usa el archivo completo, sin cambios.',
      },
      {
        name: "format",
        detail:
          'elige qué parser integrado usar — "json" o "env" — sobreescribiendo la detección por extensión. Útil cuando path no tiene una extensión que detectar. Se ignora si parser está definido.',
      },
      {
        name: "parser",
        detail:
          "sobreescribe el parseo por defecto: recibe los bytes crudos del archivo y retorna el árbol de config parseado. Útil para formatos que este módulo no parsea, como YAML con una librería propia.",
      },
      {
        name: "reduce",
        detail:
          "combina cada lectura con el valor publicado anteriormente en vez de reemplazarlo por completo. Útil con watch (el default) cuando una lectura posterior debería mezclarse con lo que ya hay en vez de reemplazarlo del todo. Recibe el árbol recién leído (y ya filtrado por treePath) como incoming y el último valor publicado como previous (null antes de la primera lectura). Por defecto publica incoming tal cual — un reemplazo completo.",
      },
    ],
    note: "Un archivo ausente, una extensión no reconocida, o un parseo fallido (incluso en un cambio observado posterior) se registra vía console.error y deja el store vacío en vez de lanzar — un error de parseo en un cambio posterior conserva el último valor bueno. Si treePath apunta a un segmento ausente o que no es un objeto, también se registra un error, pero igual publica un snapshot vacío ({}) en vez de null, ya que el archivo sí se leyó y parseó bien.",
    example: `import { fileSource } from "@jondotsoy/configs/sources/file";

const source = fileSource<{ port: number; host: string }>("./config.json");
// config.json: { "port": 3000, "host": "localhost" }`,
  },
  {
    name: "pullSource",
    path: "@jondotsoy/configs/sources/pull",
    description:
      "Llama a pull y publica lo que retorne como el siguiente snapshot — una vez de inmediato, y luego de nuevo cada interval milisegundos hasta que el Source se cierre. pull puede ser sync o async, así que es un escape hatch de propósito general para cualquier input que no esté cubierto por un source integrado (una consulta a base de datos, un secrets manager en la nube, una llamada gRPC, ...).",
    options: [
      {
        name: "pull",
        detail:
          "función llamada en cada ronda para producir un snapshot nuevo. Puede ser sync o async.",
      },
      {
        name: "interval",
        detail: "milisegundos entre llamadas a pull.",
      },
    ],
    note: "Un fallo de pull se registra vía console.error y se traga en vez de lanzarse: en la primera llamada esto deja el store vacío (igual que fetchSource); en una llamada posterior se salta, conservando el último valor bueno y el polling sigue corriendo.",
    example: `import { pullSource } from "@jondotsoy/configs/sources/pull";
import { Temporal } from "temporal-polyfill";

const source = pullSource<{ port: number }>({
  pull: async () => fetchPortFromSomewhere(),
  interval: Temporal.Duration.from({ seconds: 30 }).total("milliseconds"),
});`,
  },
  {
    name: "literalSource",
    path: "@jondotsoy/configs/sources/literal",
    description:
      "Publica un valor plano que ya tienes a mano (value) como snapshot de inmediato, y luego se cierra. Sin I/O, sin opciones — solo envuelve value en un Source para que pueda ir en un arreglo sources junto al resto.",
    note: "Útil como árbol de respaldo estático (ponlo al final, para que ganen los sources reales), como default hardcodeado para un solo ambiente, o como source de relleno en un test.",
    example: `import { create } from "@jondotsoy/configs";
import { envSource, mapKey } from "@jondotsoy/configs/sources/env";
import { literalSource } from "@jondotsoy/configs/sources/literal";

const cfg = await create(
  {
    port: { type: "number", required: true },
    host: { type: "string", required: true },
  },
  {
    sources: [
      envSource({ mapKey: mapKey.snakeCase() }),
      literalSource({ port: 3000, host: "localhost" }), // respaldo si faltan las env vars
    ],
  },
);`,
  },
];

const sourcesEn = [
  {
    name: "envSource",
    path: "@jondotsoy/configs/sources/env",
    description:
      "Reads environment variables — process.env or another object passed as env — into the config tree, one field per key (mapped by mapKey).",
    options: [
      {
        name: "env",
        detail: "the env vars to read. Defaults to process.env.",
      },
      {
        name: "prefix",
        detail:
          "only keys starting with prefix are included; the prefix is stripped before mapKey runs.",
      },
      {
        name: "suffix",
        detail:
          "only keys ending with suffix are included; the suffix is stripped before mapKey runs.",
      },
      {
        name: "mapKey.snakeCase(options?)",
        detail:
          'splits a SCREAMING_SNAKE_CASE key into a lowercase nested path on separator (default "_"): "FOO_TAR" => ["foo", "tar"]. A different separator (e.g. "__") keeps a single underscore inside a segment from splitting it.',
      },
      {
        name: "mapKey.identity()",
        detail:
          'passes each key through unchanged, as a single-segment path: "FOO_TAR" => ["FOO_TAR"]. Same as omitting mapKey.',
      },
      {
        name: "mapKey.camelCase()",
        detail:
          'maps a key to a single camelCase segment: "FOO_TAR" => ["fooTar"].',
      },
      {
        name: "mapKey.lookup(table, fallback?)",
        detail:
          "maps specific keys to explicit paths via a Record<string, string[]> lookup table; a key not in the table falls back to fallback (default: the identity).",
      },
    ],
    note: "You can also pass your own EnvKeyMapper instead of a built-in strategy — it's just a (key: string) => string[] function.",
    example: `import { envSource, mapKey } from "@jondotsoy/configs/sources/env";

// SERVER_PORT=3000 SERVER_HOST=localhost → { server: { port: "3000", host: "localhost" } }
const source = envSource({ mapKey: mapKey.snakeCase() });

// PORT=3000 HOST=localhost → { server: { port: "3000" }, HOST: "localhost" }
const source2 = envSource({ mapKey: mapKey.lookup({ PORT: ["server", "port"] }) });`,
  },
  {
    name: "fetchSource",
    path: "@jondotsoy/configs/sources/fetch",
    description:
      "Fetches a snapshot from url. The response body is turned into T by bodyParser (defaulting to (res) => res.json()), so non-JSON responses are supported by passing a custom parser.",
    options: [
      {
        name: "method",
        detail: "the HTTP method to use for the request.",
      },
      {
        name: "headers",
        detail: "headers to send with the request.",
      },
      {
        name: "body",
        detail:
          "request body, passed through to fetch as-is (e.g. a JSON string, FormData, Blob).",
      },
      {
        name: "signal",
        detail:
          "aborts the in-flight fetch (and stops retrying it) when the signal fires. Only covers a single round — with pollingInterval set, later rounds still run; close the Source itself to stop polling entirely.",
      },
      {
        name: "mode / cache / redirect",
        detail:
          'passed through to fetch as-is. See RequestInit["mode"], RequestInit["cache"] and RequestInit["redirect"].',
      },
      {
        name: "credentials",
        detail:
          "sets the Authorization header: { basic: { username, password } } sends Basic <base64>; { bearer: { token } } sends Bearer <token>.",
      },
      {
        name: "bodyParser",
        detail:
          "turns the fetched Response into T. Defaults to (res) => res.json().",
      },
      {
        name: "acceptStatus",
        detail:
          "decides whether a response's status code counts as accepted. Defaults to 2xx: (statusCode) => statusCode >= 200 && statusCode < 300.",
      },
      {
        name: "attempts",
        detail:
          "retries the download on a network error or a non-ok response (default 1, no retry).",
      },
      {
        name: "pollingInterval",
        detail:
          "off by default (false): fetchSource fetches url once and closes. Pass a number of milliseconds to turn polling on — it keeps re-fetching on that interval (each round still retried up to attempts times) until the Source is closed.",
      },
      {
        name: "treePath",
        detail:
          'selects a subtree of the fetched body to use as the config tree instead of the whole thing, e.g. ["containers", "settings"]. Defaults to [], the whole body unchanged.',
      },
      {
        name: "reduce",
        detail:
          "combines each successful fetch with the previously published value instead of replacing it outright. Useful with pollingInterval when a later round's response is a partial update. Receives the freshly fetched (and treePath-selected) body as incoming and the last published value as previous (null before the first round). Defaults to publishing incoming as-is — a full replace.",
      },
    ],
    note: "If the download never succeeds (a network error, or a status rejected by acceptStatus after exhausting attempts), or bodyParser throws, fetchSource logs a console.error and leaves the store empty instead of throwing. A failed round after the first one is logged and skipped, without closing the source or stopping the polling.",
    example: `import { fetchSource } from "@jondotsoy/configs/sources/fetch";
import { Temporal } from "temporal-polyfill";

const source = fetchSource<{ port: number }>({
  url: "https://config-service.internal/app",
  method: "GET",
  headers: { authorization: \`Bearer \${process.env.CONFIG_TOKEN}\` },
  attempts: 3,
  // Off by default — pass milliseconds to poll instead of a single fetch.
  pollingInterval: Temporal.Duration.from({ seconds: 30 }).total("milliseconds"),
});`,
  },
  {
    name: "sseSource",
    path: "@jondotsoy/configs/sources/sse",
    description:
      "Connects to an SSE endpoint. Every message tries to parse as JSON and, if it's a plain object, is applied as a patch on top of what was already received — fields add up and overwrite, the tree is never replaced wholesale.",
    options: [
      {
        name: "method",
        detail: "the HTTP method used to open the connection.",
      },
      {
        name: "headers",
        detail: "headers to send when opening the SSE connection.",
      },
      {
        name: "body",
        detail:
          "request body, passed through to fetch as-is (e.g. a JSON string, FormData, Blob).",
      },
      {
        name: "signal",
        detail:
          "aborts the connection (and stops retrying it) when the signal fires. Independent of the Source's own close(), which also aborts the connection.",
      },
      {
        name: "mode / cache / redirect",
        detail:
          'passed through to fetch as-is. See RequestInit["mode"], RequestInit["cache"] and RequestInit["redirect"].',
      },
      {
        name: "credentials",
        detail:
          "sets the Authorization header: { basic: { username, password } } sends Basic <base64>; { bearer: { token } } sends Bearer <token>.",
      },
      {
        name: "attempts",
        detail:
          "attempts to establish the connection before giving up. Defaults to 1 (no retry).",
      },
      {
        name: "acceptStatus",
        detail:
          "decides whether a response's status code counts as accepted. Defaults to 2xx: (statusCode) => statusCode >= 200 && statusCode < 300.",
      },
      {
        name: "reduce",
        detail:
          "combines each parsed message with the config tree accumulated so far, overriding the default shallow patch-merge (new fields added, existing ones overwritten, everything else kept). Receives the parsed message as incoming and the previously published tree as previous (null before the first message). A custom reduce replaces that behavior entirely, so it must do its own merging if that's still wanted.",
      },
    ],
    note: "A message that isn't valid JSON, or doesn't parse to a plain object, is logged via console.error and skipped — it never resets what was already received. Opening the source waits for the first message (so the Store you get back already has data, not null), then keeps the connection alive in the background, applying further messages as patches until the resource closes the stream. Beyond url/method/headers, it accepts the same request-shaping options as fetchSource; attempts only retries the initial connection — once the stream is open, a dropped connection closes the source rather than reconnecting.",
    example: `import { sseSource } from "@jondotsoy/configs/sources/sse";

const source = sseSource<{ port?: number; host?: string }>({
  url: "https://config-service.internal/app/events",
});

// message: {"port":3000}       => Store<{ port: 3000 }>
// message: {"host":"10.0.0.1"} => Store<{ port: 3000, host: "10.0.0.1" }>`,
  },
  {
    name: "fileSource",
    path: "@jondotsoy/configs/sources/file",
    description:
      "Reads a config tree from path — a string or a file: URL —, parsed by its extension: .json or .env by default (matched by extension, or by the bare .env filename itself — a .env file always parses to a flat string map, one entry per KEY=VALUE line, blank lines and #-comments skipped), or any other format via a custom parser.",
    options: [
      {
        name: "watch",
        detail:
          "defaults to true: the file is re-read and the store updated live on every change; watch: false reads it once.",
      },
      {
        name: "treePath",
        detail:
          'selects a subtree of the parsed file to use as the config tree, e.g. ["containers", "settings"] to use { containers: { settings: {...} } }\'s inner object and ignore the rest of the file. Defaults to [], the whole parsed file unchanged.',
      },
      {
        name: "format",
        detail:
          'picks which built-in parser to use — "json" or "env" — overriding extension-based detection. Handy when path has no extension to detect. Ignored when parser is set.',
      },
      {
        name: "parser",
        detail:
          "overrides the default parsing entirely: receives the file's raw bytes and returns the parsed config tree. Use it for formats this module doesn't parse itself, like YAML with a library of your choice.",
      },
      {
        name: "reduce",
        detail:
          "combines each read with the previously published value instead of replacing it outright. Especially useful with watch (the default), when a later read should merge into what's already there rather than replace it wholesale. Receives the freshly read (and treePath-selected) tree as incoming and the last published value as previous (null before the first read). Defaults to publishing incoming as-is — a full replace.",
      },
    ],
    note: "A missing file, an unrecognized extension, or a parse failure (including on a later watched change) is logged via console.error and leaves the store empty instead of throwing — a parse error on a later change keeps the last good value instead. If treePath points at a missing or non-object segment, it's also logged via console.error, but it still publishes an empty snapshot ({}) instead of null, since the file itself was read and parsed fine.",
    example: `import { fileSource } from "@jondotsoy/configs/sources/file";

const source = fileSource<{ port: number; host: string }>("./config.json");
// config.json: { "port": 3000, "host": "localhost" }`,
  },
  {
    name: "pullSource",
    path: "@jondotsoy/configs/sources/pull",
    description:
      "Calls pull and publishes whatever it returns as the next snapshot — once immediately, then again every interval milliseconds until the Source is closed. pull can be sync or async, so it's a general-purpose escape hatch for any input that isn't already covered by a built-in source (a database query, a cloud secrets manager, a gRPC call, ...).",
    options: [
      {
        name: "pull",
        detail:
          "called on every round to produce a fresh snapshot. May be sync or async.",
      },
      {
        name: "interval",
        detail: "milliseconds between calls to pull.",
      },
    ],
    note: "A pull failure is logged via console.error and swallowed instead of thrown: on the first call this leaves the store empty (same as fetchSource); on a later call it's skipped, keeping the last good value and the polling running.",
    example: `import { pullSource } from "@jondotsoy/configs/sources/pull";
import { Temporal } from "temporal-polyfill";

const source = pullSource<{ port: number }>({
  pull: async () => fetchPortFromSomewhere(),
  interval: Temporal.Duration.from({ seconds: 30 }).total("milliseconds"),
});`,
  },
  {
    name: "literalSource",
    path: "@jondotsoy/configs/sources/literal",
    description:
      "Publishes a plain, already-in-hand value as a snapshot immediately, then closes. No I/O, no options — just wraps value in a Source so it can sit in a sources array alongside the rest.",
    note: "Handy as a static fallback tree (put it last so real sources win), a hardcoded default for a single environment, or a stand-in source in a test.",
    example: `import { create } from "@jondotsoy/configs";
import { envSource, mapKey } from "@jondotsoy/configs/sources/env";
import { literalSource } from "@jondotsoy/configs/sources/literal";

const cfg = await create(
  {
    port: { type: "number", required: true },
    host: { type: "string", required: true },
  },
  {
    sources: [
      envSource({ mapKey: mapKey.snakeCase() }),
      literalSource({ port: 3000, host: "localhost" }), // fallback if env vars are unset
    ],
  },
);`,
  },
];

