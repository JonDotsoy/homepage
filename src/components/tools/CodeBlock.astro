---
interface Props {
  title: string;
  code: string;
}

const { title, code } = Astro.props;
---

<div class="flex flex-col gap-2">
  <h2
    class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"
  >
    {title}
  </h2>
  <pre
    class="max-h-[32rem] overflow-auto rounded-md border border-border bg-muted p-4 text-xs text-foreground"><code>{code}</code></pre>
</div>
