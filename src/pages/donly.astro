<script>
  const button = document.getElementById(
    "copy-page-button",
  ) as HTMLButtonElement | null;
  const label = button?.querySelector("span");
  const markdownSource = document.getElementById("page-markdown-source");

  button?.addEventListener("click", async () => {
    if (!label || !markdownSource) return;
    try {
      await navigator.clipboard.writeText(markdownSource.textContent ?? "");
      const original = label.textContent;
      label.textContent = button.dataset.copiedLabel ?? original;
      setTimeout(() => {
        label.textContent = original;
      }, 1500);
    } catch (error) {
      console.error("Failed to copy page as markdown", error);
    }
  });

  const installButton = document.getElementById(
    "copy-install-button",
  ) as HTMLButtonElement | null;

  installButton?.addEventListener("click", async () => {
    const text = installButton.dataset.copyText;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      installButton.setAttribute(
        "aria-label",
        installButton.dataset.copiedLabel ?? "Copiado",
      );
      installButton.classList.add("text-foreground");
      setTimeout(() => {
        installButton.setAttribute(
          "aria-label",
          "Copiar comando de instalación",
        );
        installButton.classList.remove("text-foreground");
      }, 1500);
    } catch (error) {
      console.error("Failed to copy install command", error);
    }
  });

  const heroTabTriggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-hero-tab]",
  );
  const heroPanels = document.querySelectorAll<HTMLElement>(
    "[data-hero-panel]",
  );

  heroTabTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const target = trigger.dataset.heroTab;
      heroTabTriggers.forEach((t) =>
        t.setAttribute("aria-selected", String(t === trigger)),
      );
      heroPanels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.dataset.heroPanel !== target);
      });
    });
  });

  const pageMenu = document.querySelector("header details");
  document.addEventListener("click", (event) => {
    if (
      pageMenu instanceof HTMLDetailsElement &&
      pageMenu.open &&
      !pageMenu.contains(event.target as Node)
    ) {
      pageMenu.open = false;
    }
  });
  pageMenu?.addEventListener("click", (event) => {
    if (
      pageMenu instanceof HTMLDetailsElement &&
      (event.target as HTMLElement).closest("a")
    ) {
      pageMenu.open = false;
    }
  });
</script>

