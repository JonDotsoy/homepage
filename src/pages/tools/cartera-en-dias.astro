---
import DefaultLayout from "@/components/layouts/DefaultLayout.astro";
import CarteraEnDias from "@/components/tools/CarteraEnDias.tsx";
import { ArrowLeft } from "lucide-react";
---

<DefaultLayout
  title="¿Cuántos días te quedan? — Herramientas"
  description="Herramienta client-only que representa, en días, cuánto te alcanzan tus recursos actuales para seguir viviendo con la misma calidad de vida según tus gastos mensuales."
  lang="es"
>
  <main class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-16">
    <header>
      <a
        href="/utils"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <ArrowLeft className="size-4" />
        Utils
      </a>
    </header>

    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-semibold text-foreground">
        ¿Cuántos días te quedan?
      </h1>
      <p class="text-sm text-muted-foreground">
        Una representación en días de los recursos que te quedan hoy: a partir
        de tu saldo actual y tus gastos mensuales, mide cuánto tiempo podrías
        seguir viviendo con la misma calidad de vida. Todo se procesa y guarda
        en tu navegador.
      </p>
    </div>

    <CarteraEnDias client:only="react" />
  </main>
</DefaultLayout>
