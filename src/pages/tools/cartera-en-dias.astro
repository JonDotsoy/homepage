---
import DefaultLayout from "@/components/layouts/DefaultLayout.astro";
import CarteraEnDias from "@/components/tools/CarteraEnDias.tsx";
import { ArrowLeft } from "lucide-react";
---

<DefaultLayout
  title="Cartera en días — Herramientas"
  description="Herramienta client-only para calcular cuántos días te alcanza tu saldo según tus gastos mensuales fijos."
  lang="es"
>
  <main class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-16">
    <header>
      <a
        href="/utils"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <ArrowLeft className="size-4" />
        Utils
      </a>
    </header>

    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-semibold text-foreground">Cartera en días</h1>
      <p class="text-sm text-muted-foreground">
        Cuánto te alcanza tu saldo actual según tus gastos fijos mensuales. Todo
        se procesa y guarda en tu navegador.
      </p>
    </div>

    <CarteraEnDias client:only="react" />
  </main>
</DefaultLayout>
